# =============================================================================
# local-coder-web .gitignore
# =============================================================================

# ONNX embedding models (large binary files, download separately).
# Keep the Python package tracked; ignore model payloads below it.
models/*
!models/
!models/__init__.py

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Temp files
*.tmp
*.log
_fix_*.py
