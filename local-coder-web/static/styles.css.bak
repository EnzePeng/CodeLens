/* ============================================
   CodeLens - Modern UI Design System
   ============================================ */

/* CSS Variables */
:root {
  /* Colors */
  --primary: #6366f1;
  --primary-hover: #4f46e5;
  --primary-light: #e0e7ff;
  --success: #10b981;
  --warning: #f59e0b;
  --error: #ef4444;
  
  /* Background */
  --bg-primary: #ffffff;
  --bg-secondary: #f8fafc;
  --bg-tertiary: #f1f5f9;
  --bg-hover: #e2e8f0;
  
  /* Text */
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  
  /* Border */
  --border: #e2e8f0;
  --border-focus: #6366f1;
  
  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  
  /* Spacing */
  --sidebar-width: 280px;
  --header-height: 56px;
  --composer-height: 80px;
  
  /* Transitions */
  --transition: all 0.2s ease;
}

/* Dark Theme */
[data-theme="dark"] {
  --bg-primary: #0f172a;
  --bg-secondary: #1e293b;
  --bg-tertiary: #334155;
  --bg-hover: #475569;
  
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  --border: #334155;
  --border-focus: #818cf8;
  
  --primary-light: #312e81;
  
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
}

/* Reset & Base */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  overflow: hidden;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--text-primary);
  background: var(--bg-primary);
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.3s, color 0.3s;
}

/* Shell Layout */
.shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* Sidebar */
.sidebar {
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  background: var(--bg-secondary);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.sidebar-resize {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  cursor: col-resize;
  background: transparent;
  z-index: 10;
  transition: background 0.15s;
}

.sidebar-resize:hover,
.sidebar-resize.active {
  background: var(--primary);
}

/* ============================================
   Sidebar
   ============================================ */
.sidebar {
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  background: var(--bg-secondary);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Brand */
.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.logo {
  flex-shrink: 0;
}

.brand-text h1 {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5px;
}

.brand-text p {
  font-size: 12px;
  color: var(--text-muted);
}

.theme-toggle {
  margin-left: auto;
  width: 36px;
  height: 36px;
  border: none;
  background: var(--bg-tertiary);
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  transition: var(--transition);
}

.theme-toggle:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
}

.moon-icon { display: none; }
[data-theme="dark"] .sun-icon { display: none; }
[data-theme="dark"] .moon-icon { display: block; }

/* Folder Section */
.folder-section {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.field {
  display: block;
  margin-bottom: 12px;
}

.field-label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.folder-input-row {
  display: flex;
  gap: 8px;
}

.folder-input-row input {
  flex: 1;
  height: 36px;
  padding: 0 12px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 13px;
  color: var(--text-primary);
  cursor: pointer;
}

.folder-input-row input:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.browse-btn {
  width: 36px;
  height: 36px;
  border: 1px solid var(--border);
  background: var(--bg-primary);
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  transition: var(--transition);
}

.browse-btn:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.primary-btn {
  width: 100%;
  height: 36px;
  padding: 0 16px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: var(--transition);
}

.primary-btn:hover {
  background: var(--primary-hover);
}

.primary-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Stats Card */
.stats-card {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
}

.stat-item + .stat-item {
  border-top: 1px solid var(--border);
}

.stat-label {
  font-size: 12px;
  color: var(--text-muted);
}

.stat-value {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
}

/* Settings Panel */
.settings-panel {
  border-bottom: 1px solid var(--border);
}

.settings-toggle {
  width: 100%;
  padding: 12px 20px;
  background: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition);
}

.settings-toggle:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.settings-toggle span {
  flex: 1;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
}

.settings-arrow {
  transition: transform 0.2s ease;
}

.settings-toggle.active .settings-arrow {
  transform: rotate(90deg);
}

.settings-content {
  padding: 0 20px 16px;
  display: none;
}

.settings-content.show {
  display: block;
}

.settings-grid {
  display: grid;
  gap: 12px;
}

.setting-item label {
  display: block;
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.setting-hint {
  display: inline-block;
  width: 14px;
  height: 14px;
  line-height: 14px;
  text-align: center;
  font-size: 10px;
  background: var(--bg-tertiary);
  border-radius: 50%;
  color: var(--text-muted);
  cursor: help;
  margin-left: 4px;
}

.setting-select {
  width: 100%;
  height: 32px;
  padding: 0 8px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  color: var(--text-primary);
}

.settings-divider {
  height: 1px;
  background: var(--border);
  margin: 16px 0;
}

.prompts-section {
  margin-top: 12px;
}

.prompts-title {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.prompt-card {
  padding: 8px 12px;
  background: var(--bg-tertiary);
  border-radius: 6px;
  margin-bottom: 8px;
}

.prompt-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 4px;
}

.prompt-badge.ask { background: #dbeafe; color: #1e40af; }
.prompt-badge.plan { background: #fef3c7; color: #92400e; }
.prompt-badge.craft { background: #d1fae5; color: #065f46; }

[data-theme="dark"] .prompt-badge.ask { background: #1e3a5f; color: #93c5fd; }
[data-theme="dark"] .prompt-badge.plan { background: #451a03; color: #fcd34d; }
[data-theme="dark"] .prompt-badge.craft { background: #064e3b; color: #6ee7b7; }

.prompt-text {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.4;
  max-height: 60px;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Context Indicator */
.context-indicator {
  padding: 12px 20px;
  border-bottom: 1px solid var(--border);
}

.context-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 12px;
  color: var(--text-muted);
}

.context-bar {
  height: 4px;
  background: var(--bg-tertiary);
  border-radius: 2px;
  overflow: hidden;
}

.context-bar-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 2px;
  transition: width 0.3s ease;
}

.context-usage { color: var(--primary); font-weight: 600; }
.context-total { color: var(--text-muted); }

/* File Tree Section */
.file-tree-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tree-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px;
}

.tree-title {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.icon-btn {
  width: 28px;
  height: 28px;
  border: none;
  background: none;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: var(--transition);
}

.icon-btn:hover {
  background: var(--bg-tertiary);
  color: var(--text-primary);
}

.tree-search {
  padding: 0 16px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-secondary);
}

.tree-search svg {
  color: var(--text-muted);
  flex-shrink: 0;
}

.tree-search input {
  flex: 1;
  height: 32px;
  padding: 0 8px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 13px;
  color: var(--text-primary);
}

.tree-search input:focus {
  outline: none;
  border-color: var(--border-focus);
}

.tree-view {
  flex: 1;
  overflow-y: auto;
  padding: 0 8px 16px;
}

/* ============================================
   Workspace
   ============================================ */
.workspace {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.workspace-header {
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-secondary);
}

.workspace-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}

.workspace-title svg {
  color: var(--primary);
}

.workspace-actions {
  display: flex;
  gap: 8px;
}

/* Workspace Content - Cursor-style layout */
.workspace-content {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
}

/* Main area: chat + editor */
.main-split {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  min-width: 0;
}

/* Left: Chat panel */
.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-right: 1px solid var(--border);
  position: relative;
}

.scroll-bottom-btn {
  position: absolute;
  bottom: 12px;
  right: 12px;
  padding: 6px 12px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 12px;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  z-index: 5;
}

.scroll-bottom-btn:hover {
  background: var(--primary-hover);
}

/* Tab Bar */
.tab-bar {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  padding: 0 12px;
  min-height: 40px;
  flex-shrink: 0;
}

.tab-list {
  flex: 1;
  display: flex;
  gap: 2px;
  overflow-x: auto;
}

.tab-actions {
  display: flex;
  gap: 4px;
  margin-left: 8px;
}

/* Editor Area - right side, hidden by default */
.editor-area {
  display: none;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-primary);
  min-width: 0;
}

.editor-area.has-editor {
  display: flex;
}

.editor-area.collapsed {
  display: none !important;
}

.editor-container {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.editor-welcome {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
}

.editor-welcome svg {
  margin-bottom: 16px;
  opacity: 0.5;
}

.editor-welcome p {
  font-size: 14px;
}

.welcome-hint {
  font-size: 12px !important;
  margin-top: 4px;
}

/* Split resize handle */
.split-resize {
  width: 4px;
  cursor: col-resize;
  background: transparent;
  flex-shrink: 0;
  transition: background 0.15s;
}

.split-resize:hover {
  background: var(--primary);
}

/* Agent Panel - right side, hidden by default */
.agent-panel {
  display: none;
  flex-direction: column;
  flex: 0 0 45%;
  min-width: 400px;
  max-width: 600px;
  border-left: 1px solid var(--border);
  background: var(--bg-primary);
  overflow: hidden;
}

.agent-panel.active {
  display: flex;
}

.agent-panel.hidden {
  display: none !important;
}

.agent-panel.fullscreen {
  position: fixed;
  inset: 0;
  z-index: 50;
  flex: none;
  width: 100%;
  min-width: 0;
  max-width: none;
  border-left: none;
}

/* Main split (left: chat + editor) */
.main-split {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  min-width: 0;
  position: relative;
}

.split-resize {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  cursor: col-resize;
  background: transparent;
  z-index: 10;
  transition: background 0.15s;
}

.split-resize:hover,
.split-resize.active {
  background: var(--primary);
}

/* Left: Chat panel */
.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  border-right: 1px solid var(--border);
  position: relative;
}

.scroll-bottom-btn {
  position: absolute;
  bottom: 12px;
  right: 12px;
  padding: 6px 12px;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 12px;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  z-index: 5;
}

.scroll-bottom-btn:hover {
  background: var(--primary-hover);
}

/* Tab Bar (inside editor area) */
.tab-bar {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  padding: 0 12px;
  min-height: 40px;
  flex-shrink: 0;
}

.tab-list {
  flex: 1;
  display: flex;
  gap: 2px;
  overflow-x: auto;
}

.tab-actions {
  display: flex;
  gap: 4px;
  margin-left: 8px;
}

/* Editor Area (right side, hidden by default) */
.editor-area {
  display: flex;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-primary);
  min-width: 0;
}

.editor-area.collapsed {
  display: none !important;
}

.editor-area.fullscreen {
  position: fixed;
  inset: 0;
  z-index: 50;
}

.editor-container {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* Messages Area */
.messages {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 20px;
}

.message {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.message-avatar {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-avatar svg {
  color: var(--primary);
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.role {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
}

.time {
  font-size: 11px;
  color: var(--text-muted);
}

.content {
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-primary);
}

.content p {
  margin-bottom: 12px;
}

.content p:last-child {
  margin-bottom: 0;
}

.content table {
  width: 100%;
  border-collapse: collapse;
  margin: 12px 0;
  font-size: 13px;
}

.content th,
.content td {
  padding: 8px 12px;
  border: 1px solid var(--border);
  text-align: left;
}

.content th {
  background: var(--bg-secondary);
  font-weight: 600;
}

.content tr:nth-child(even) {
  background: var(--bg-tertiary);
}

/* Quick Actions */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 16px 0;
  align-items: center;
}

.quick-label {
  font-size: 12px;
  color: var(--text-muted);
}

.quick-btn {
  padding: 6px 12px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 12px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: var(--transition);
}

.quick-btn:hover {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary);
}

.tips {
  margin-top: 16px;
  padding: 12px;
  background: var(--bg-tertiary);
  border-radius: 8px;
  font-size: 12px;
  color: var(--text-muted);
}

kbd {
  display: inline-block;
  padding: 2px 6px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
}

/* Terminal Panel */
.terminal-panel {
  height: 200px;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.terminal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 16px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
}

.terminal-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-secondary);
}

.terminal-container {
  flex: 1;
  background: #1e1e1e;
}

/* Agent Panel (right side overlay) */
.agent-panel {
  border-left: 1px solid var(--border);
  display: none;
  flex-direction: column;
  width: 45%;
  min-width: 400px;
  background: var(--bg-primary);
  z-index: 10;
}

.agent-panel.active {
  display: flex;
}

.agent-panel.hidden {
  display: none !important;
}

.agent-panel.fullscreen {
  position: fixed;
  inset: 0;
  z-index: 50;
  width: 100%;
  min-width: 0;
  border-left: none;
}

.agent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.agent-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.agent-title svg {
  color: var(--primary);
}

.agent-controls {
  display: flex;
  gap: 4px;
}

/* Phase Bar */
.agent-phase-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 16px;
  gap: 8px;
  flex-shrink: 0;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
}

.phase-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.phase-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}

.phase-step.active .phase-icon {
  background: var(--primary);
  color: white;
}

.phase-step.completed .phase-icon {
  background: var(--success);
  color: white;
}

.phase-label {
  font-size: 10px;
  color: var(--text-muted);
}

.phase-connector {
  width: 30px;
  height: 2px;
  background: var(--border);
  margin-top: -10px;
}

/* Agent Thinking */
.agent-thinking {
  padding: 12px 16px;
  background: var(--bg-tertiary);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  max-height: 200px;
  overflow-y: auto;
}

.thinking-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}

.thinking-content {
  font-size: 12px;
  color: var(--text-secondary);
  font-family: 'JetBrains Mono', monospace;
  white-space: pre-wrap;
  word-break: break-word;
}

/* Agent Body */
.agent-body {
  display: flex;
  flex: 1;
  overflow: hidden;
  min-height: 0;
}

.agent-main-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

.agent-side-col {
  flex: 0 0 0%;
  overflow-y: auto;
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: column;
}

.agent-panel.preview-phase .agent-side-col {
  flex: 0 0 40%;
}

/* Agent TODO Panel */
.agent-todo-panel {
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.agent-todo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  background: var(--bg-secondary);
  font-size: 12px;
  font-weight: 600;
  color: var(--text-primary);
}

.agent-todo-progress {
  font-size: 11px;
  color: var(--text-muted);
  font-weight: 400;
}

.agent-todo-list {
  max-height: 300px;
  overflow-y: auto;
}

.agent-todo-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 12px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  color: var(--text-secondary);
  transition: background 0.15s;
}

.agent-todo-item:hover {
  background: var(--bg-tertiary);
}

.agent-todo-item:last-child {
  border-bottom: none;
}

.agent-todo-check {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
  transition: all 0.2s;
}

.agent-todo-item.done .agent-todo-check {
  background: var(--success);
  border-color: var(--success);
}

.agent-todo-item.done .agent-todo-check::after {
  content: "✓";
  color: white;
  font-size: 10px;
  font-weight: bold;
}

.agent-todo-item.active .agent-todo-check {
  border-color: var(--primary);
  animation: pulse 1s infinite;
}

.agent-todo-item.active .agent-todo-check::after {
  content: "●";
  color: var(--primary);
  font-size: 8px;
}

.agent-todo-text {
  flex: 1;
  line-height: 1.4;
}

.agent-todo-item.done .agent-todo-text {
  text-decoration: line-through;
  color: var(--text-muted);
}

.agent-todo-item.active .agent-todo-text {
  color: var(--text-primary);
  font-weight: 500;
}

.agent-section-header {
  padding: 8px 16px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

/* Preview */
.agent-preview {
  padding: 16px;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  font-size: 13px;
  font-weight: 500;
}

.preview-count {
  font-size: 12px;
  color: var(--text-muted);
}

.preview-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}

.btn-approve, .btn-reject {
  flex: 1;
  padding: 8px;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.btn-approve {
  background: var(--success);
  color: white;
}

.btn-approve:hover {
  background: #059669;
}

.btn-reject {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
}

.btn-reject:hover {
  background: var(--error);
  color: white;
}

/* Agent Steps */
.agent-steps {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
}

.agent-step-card {
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 8px;
  overflow: hidden;
}

.agent-step-card.active {
  border-color: var(--primary);
  box-shadow: 0 0 0 1px var(--primary);
}

.agent-step-card.success {
  border-color: var(--success);
}

.agent-step-card.failed {
  border-color: var(--error);
}

.agent-step-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg-secondary);
  cursor: pointer;
  user-select: none;
}

.agent-step-header:hover {
  background: var(--bg-tertiary);
}

.agent-step-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  flex-shrink: 0;
}

.agent-step-card.active .agent-step-num {
  background: var(--primary);
  color: white;
  animation: pulse 1s infinite;
}

.agent-step-card.success .agent-step-num {
  background: var(--success);
  color: white;
}

.agent-step-card.failed .agent-step-num {
  background: var(--error);
  color: white;
}

.agent-step-tool {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
}

.agent-step-summary {
  font-size: 12px;
  color: var(--text-muted);
  margin-left: auto;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-step-arrow {
  color: var(--text-muted);
  transition: transform 0.2s;
  flex-shrink: 0;
}

.agent-step-card.expanded .agent-step-arrow {
  transform: rotate(90deg);
}

.agent-step-body {
  display: none;
  padding: 12px;
  border-top: 1px solid var(--border);
  background: var(--bg-primary);
}

.agent-step-card.expanded .agent-step-body {
  display: block;
}

.agent-step-section {
  margin-bottom: 10px;
}

.agent-step-section:last-child {
  margin-bottom: 0;
}

.agent-step-section-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 4px;
}

.agent-step-section-content {
  font-size: 12px;
  font-family: 'JetBrains Mono', monospace;
  color: var(--text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
  background: var(--bg-tertiary);
  padding: 8px 10px;
  border-radius: 4px;
  max-height: 300px;
  overflow-y: auto;
}

.agent-step-thinking {
  font-style: italic;
  color: var(--text-muted);
}

.agent-step-result {
  color: var(--text-primary);
}

.agent-step-error {
  color: var(--error);
}

/* Agent Output */
.agent-output {
  border-top: 1px solid var(--border);
  max-height: 200px;
  overflow-y: auto;
}

.agent-output.hidden {
  display: none;
}

.agent-output-content {
  padding: 12px;
  font-size: 12px;
  font-family: 'JetBrains Mono', monospace;
}

.agent-output-content .success { color: var(--success); }
.agent-output-content .error { color: var(--error); }
.agent-output-content .warning { color: var(--warning); }

/* ============================================
   Composer
   ============================================ */
.composer {
  padding: 16px 20px;
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
}

.composer-row {
  display: flex;
  gap: 12px;
  align-items: flex-end;
}

.mode-select {
  height: 44px;
  padding: 0 12px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  cursor: pointer;
}

.mode-select:focus {
  outline: none;
  border-color: var(--border-focus);
}

.input-wrapper {
  flex: 1;
  position: relative;
}

.input-wrapper textarea {
  width: 100%;
  min-height: 44px;
  max-height: 120px;
  padding: 10px 44px 10px 16px;
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-size: 14px;
  color: var(--text-primary);
  resize: none;
  font-family: inherit;
}

.input-wrapper textarea:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px var(--primary-light);
}

.input-wrapper textarea::placeholder {
  color: var(--text-muted);
}

.input-actions {
  position: absolute;
  right: 8px;
  bottom: 8px;
}

.input-action-btn {
  width: 28px;
  height: 28px;
  border: none;
  background: none;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: var(--transition);
}

.input-action-btn:hover {
  background: var(--bg-tertiary);
  color: var(--primary);
}

.submit-btn {
  width: 44px;
  height: 44px;
  border: none;
  background: var(--primary);
  border-radius: 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  transition: var(--transition);
}

.submit-btn:hover:not(:disabled) {
  background: var(--primary-hover);
  transform: scale(1.05);
}

.submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================
   Overlays
   ============================================ */
.dir-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.dir-dialog {
  width: 90%;
  max-width: 600px;
  max-height: 80vh;
  background: var(--bg-primary);
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dir-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.dir-header h3 {
  font-size: 16px;
  font-weight: 600;
}

.dir-path-bar {
  display: flex;
  gap: 8px;
  padding: 12px 20px;
  border-bottom: 1px solid var(--border);
}

.dir-path-bar input {
  flex: 1;
  height: 36px;
  padding: 0 12px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 13px;
  color: var(--text-primary);
}

.dir-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px 12px;
  max-height: 400px;
}

.dir-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 20px;
  border-top: 1px solid var(--border);
}

.dir-current {
  font-size: 12px;
  color: var(--text-muted);
}

/* Modal */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-dialog {
  background: var(--bg-primary);
  border-radius: 12px;
  padding: 24px;
  min-width: 320px;
  box-shadow: var(--shadow-lg);
}

.modal-dialog h3 {
  margin: 0 0 16px;
  font-size: 16px;
  color: var(--text-primary);
}

.modal-input {
  width: 100%;
  padding: 10px 12px;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  color: var(--text-primary);
  outline: none;
}

.modal-input:focus {
  border-color: var(--border-focus);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 16px;
}

.modal-cancel {
  padding: 8px 16px;
  background: var(--bg-tertiary);
  border: none;
  border-radius: 6px;
  color: var(--text-secondary);
  cursor: pointer;
}

.modal-confirm {
  padding: 8px 16px;
  background: var(--primary);
  border: none;
  border-radius: 6px;
  color: white;
  cursor: pointer;
}

.modal-confirm:hover {
  background: var(--primary-hover);
}

/* ============================================
   Utilities
   ============================================ */
.hidden {
  display: none !important;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

/* Selection */
::selection {
  background: var(--primary-light);
  color: var(--primary);
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.message {
  animation: fadeIn 0.3s ease;
}

/* Responsive */
@media (max-width: 768px) {
  .sidebar {
    position: fixed;
    left: -280px;
    top: 0;
    bottom: 0;
    z-index: 100;
    transition: left 0.3s ease;
  }
  
  .sidebar.open {
    left: 0;
  }
  
  .agent-side-col {
    display: none;
  }
}
